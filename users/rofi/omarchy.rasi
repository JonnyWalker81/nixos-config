/* Omarchy — Tokyo Night rofi theme.
 * Centered, rounded, icons on. Shared by drun / run / window / clipboard / dmenu.
 * Palette matches ~/Repositories/dwm/config.h (Tokyo Night). */

* {
    bg0:     #1a1b26f2;   /* window bg, ~95% opaque (picom is told to leave rofi alone) */
    bg1:     #24283b;     /* input / rows bg */
    bg-sel:  #2e3440;     /* selected row bg */
    dim:     #3e4554;     /* placeholder / empty / border */
    fg:      #a9b1d6;     /* normal foreground */
    blue:    #7aa2f7;
    cyan:    #b4f9f8;     /* selection accent */
    red:     #f7768e;

    background-color: transparent;
    text-color:       @fg;
    font: "JetBrainsMono Nerd Font 13";
}

configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    drun-display-format: "{name}";
    display-drun:        "";
    display-run:         "";
    display-window:      "";
    display-clipboard:   "";
}

window {
    width:            640px;
    border:           2px;
    border-color:     @dim;
    border-radius:    12px;
    background-color: @bg0;
    padding:          0px;
}

mainbox {
    padding:  12px;
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}
prompt { text-color: @blue; }
entry  { placeholder: "Search"; placeholder-color: @dim; cursor: text; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
    padding:      6px 2px 0px 2px;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 8px;
}
element normal    normal { text-color: @fg; }
element alternate normal { text-color: @fg; }
element selected  normal { background-color: @bg-sel; text-color: @cyan; }
element normal    active { text-color: @blue; }
element selected  active { background-color: @bg-sel; text-color: @cyan; }

element-icon { size: 1.4em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }

/* Message row used by omarchy-keys (-mesg) */
message { padding: 6px 2px 0px 2px; }
textbox { text-color: @dim; }

error-message { padding: 12px; }
